# Copy to .env and fill in. This file is git-ignored; .env.example is not.
# Agent token: https://openmarket.xyz/chart/console/agents (creator sits
#   below the "Try a prompt" cards; sidebar API Keys if hidden).
#   NOT the "paste one sentence" box - that is for browser-OAuth agents.
#   scopes for v1: mcp:read + mcp:chart (+ mcp:alerts if you ticked the box)
#   add mcp:trade ONLY when you understand agent/README.md's trade section.
OM_MCP_TOKEN=
GROQ_API_KEY=

# The chart the agent watches (workspace id from your OpenMarket URL / message)
OM_WORKSPACE=RV0MBetJ

# Groq model (OpenAI-compatible endpoint). Any chat model on your key works.
GROQ_MODEL=openai/gpt-oss-120b

# Cadence for `python -m agent watch`, in minutes
AGENT_CADENCE_MIN=15

# Candles pulled per observation (max 300; every bar costs tokens)
AGENT_BARS=200

# Trade execution is OFF unless this is true AND you pass --confirm AND your
# browser tab has armed the agent AND you answer y at the prompt. Four locks.
AGENT_TRADE=false
